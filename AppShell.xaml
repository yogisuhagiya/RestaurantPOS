<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RestaurantPOS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RestaurantPOS"
    xmlns:pages="clr-namespace:RestaurantPOS.Pages"
    xmlns:pagesM="clr-namespace:RestaurantPosMAUI.MVVM.Pages"
    Title="Restaurant POS"
    Shell.FlyoutBackgroundColor="#ADD8E6"
    Shell.ForegroundColor="White"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutWidth="60">

    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate pagesM:SignUpPage}"
    Icon="home.png"
    Route="SignUpPage"
        FlyoutItemIsVisible="False" />

    <ShellContent
   Title="Home"
   ContentTemplate="{DataTemplate pagesM:SignInPage}"
   Icon="home.png"
   Route="SignInPage" 
        FlyoutItemIsVisible="False"/>


    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Icon="home.png"
        Route="MainPage" />

    <ShellContent
        Title="Orders"
        ContentTemplate="{DataTemplate pages:OrdersPage}"
        Icon="list.png"
        Route="OrdersPage" />

    <ShellContent
        Title="Manage Menu"
        ContentTemplate="{DataTemplate pages:ManageMenuItemPage}"
        Icon="grid.png"
        Route="ManageMenuItemPage" />

    <Shell.FlyoutFooter>
        <Image
            Margin="0,0,0,25"
            Aspect="AspectFit"
            HeightRequest="20"
            HorizontalOptions="Center"
            Source="envelope.png"
            ToolTipProperties.Text="Support"
            WidthRequest="20">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </Image.GestureRecognizers>
        </Image>
    </Shell.FlyoutFooter>
</Shell>
