<?xml version="1.0" encoding="utf-8" ?>

<!-- 
  HelpPopup.xaml: A reusable popup control that displays developer support information.
  It provides a way for users to get help by email or visit a website.
-->
<toolkit:Popup
    x:Class="RestaurantPOS.Controls.HelpPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RestaurantPOS.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="this"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">
    <!-- Popup container with rounded corners and drop shadow -->

    <Border
        BackgroundColor="Wheat"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="0">
        <Border.Shadow>
            <Shadow Brush="Maroon" Radius="15" />
        </Border.Shadow>

        <!-- Header bar with "Need help?" label and close (X) button -->

        <VerticalStackLayout>

            <!--  Need help header bar  -->
            <Grid
                Padding="15,8"
                BackgroundColor="Maroon"
                ColumnDefinitions="*, Auto">
                
                <!-- Help title -->

                <Label
                    Grid.Column="0"
                    FontSize="18"
                    Text="Need help?"
                    TextColor="White" />

                <!-- Close popup button -->
                <Label
                    Grid.Column="1"
                    BackgroundColor="Red"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="25"
                    HorizontalTextAlignment="Center"
                    Text="X"
                    TextColor="White"
                    VerticalTextAlignment="Center"
                    WidthRequest="25">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CloseLabel_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Body section with contact info -->

            <VerticalStackLayout Padding="15" Spacing="10">
                <!-- Envelope icon (visual cue for email/contact) -->
                <Image
                    HeightRequest="25"
                    HorizontalOptions="Center"
                    Source="envelope.png"
                    WidthRequest="25" />
                
                <!-- Message encouraging user to connect -->

                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="You can connect with me!"
                    TextColor="Black" />

                <!-- Email address row with copy and tap-to-send features -->
                <HorizontalStackLayout Spacing="5">
                    <Label
                        FontSize="16"
                        Text="Email me at "
                        TextColor="Black"
                        VerticalOptions="Center" />
                    
                    <!-- Static "Email me at" label -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="{x:Static controls:HelpPopup.Email}"
                        TextColor="Black"
                        TextDecorations="Underline"
                        ToolTipProperties.Text="Click to send me an email"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Copy icon to copy email to clipboard -->

                    <Image
                        x:Name="CopyEmailImage"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        Source="copy.png"
                        ToolTipProperties.Text="Copy to clipboard"
                        WidthRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CopyEmail_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Footer with developer credit -->

            <Grid
                Padding="15,5"
                BackgroundColor="Maroon"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="5">
                
               

                <Label
                    Grid.Column="0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Developed by:"
                    TextColor="White"
                    VerticalOptions="Center" />

                <!-- Developer name with clickable underline -->
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalOptions="Start"
                    Text="Yogi Suhagiya"
                    TextColor="Yellow"
                    TextDecorations="Underline"
                    ToolTipProperties.Text="Click to visit my website"
                    VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Footer_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
