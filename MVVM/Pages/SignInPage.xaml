<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantPosMAUI.MVVM.ViewModels"
             x:Class="RestaurantPosMAUI.MVVM.Pages.SignInPage"
             Title="SignInPage"
             xmlns:handlers="clr-namespace:RestaurantPosMAUI.Handlers"
             x:DataType="vm:SignInViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                <Frame BackgroundColor="#ADD8E6"
                       CornerRadius="15"
                       Padding="30"
                       WidthRequest="320"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="15">
                        <!-- Heading -->
                        <Label Text="Login Page!" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Sign in to continue" 
                               FontSize="16"
                               TextColor="Gray" 
                               HorizontalOptions="Center" />

                        <!-- Email -->
                        <Frame BorderColor="LightGray" CornerRadius="8" Padding="10">
                            <handlers:BorderlessEntry x:Name="emailEntry"
                                                      Placeholder="Email"
                                                      Text="{Binding SignInModel.Email}" />
                        </Frame>

                        <!-- Password -->
                        <Frame BorderColor="LightGray" CornerRadius="8" Padding="10">
                            <handlers:BorderlessEntry x:Name="passwordEntry"
                                                      Placeholder="Password"
                                                      IsPassword="True"
                                                      Text="{Binding SignInModel.Password}" />
                        </Frame>

                        <!-- Sign In Button -->
                        <Button Text="Sign In"
                                Command="{Binding NavigateSignUpCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10" />

                        <!-- Navigate to Sign Up -->
                        <Button Text="Create an account"
                                Command="{Binding NavigateSignUpCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#4CAF50"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>