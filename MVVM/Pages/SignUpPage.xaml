<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantPosMAUI.MVVM.ViewModels"
             xmlns:handlers="clr-namespace:RestaurantPosMAUI.Handlers"
             x:DataType="vm:SignUpViewModel"
             x:Class="RestaurantPosMAUI.MVVM.Pages.SignUpPage"
             Title="SignUpPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">

                <Frame BackgroundColor="#ADD8E6"
                       CornerRadius="15"
                       Padding="30"
                       WidthRequest="320"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="15">
                        <!-- Title -->
                        <Label Text="Welcome Back!" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Sign in to your account" FontSize="16" HorizontalOptions="Center" TextColor="Gray"/>

                        <!-- Email/Username -->
                        <Frame BorderColor="LightGray" CornerRadius="8" Padding="10">
                            <handlers:BorderlessEntry x:Name="emailEntry"
                                                      Placeholder="Email "
                                                      Text="{Binding SignUpModel.Email}" />
                        </Frame>

                        <Frame BorderColor="LightGray" CornerRadius="8" Padding="10">
                            <handlers:BorderlessEntry x:Name="UsernameEntry"
                              Placeholder="Username"
                              Text="{Binding SignUpModel.Username}" />
                        </Frame>

                        <!-- Password -->
                        <Frame BorderColor="LightGray" CornerRadius="8" Padding="10">
                            <handlers:BorderlessEntry x:Name="passwordEntry"
                                                      Placeholder="Password"
                                                      IsPassword="True"
                                                      Text="{Binding SignUpModel.Password}" />
                        </Frame>

                        <!-- Sign In Button -->
                        <Button Text="Sign Up"
                                Command="{Binding NavigateSignInCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                FontAttributes="Bold" />

                        <!-- Navigate to Sign Up -->
                        <Button Text="Already have an account"
                                Command="{Binding NavigateSignInCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#4CAF50"
                                FontAttributes="Bold" />

                        <!-- Optional: Forgot Password -->
                        <!--<Label Text="Forgot your password?"
                               FontSize="14"
                               TextColor="DodgerBlue"
                               HorizontalOptions="Center" />-->
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>


</ContentPage>